{
  "app-id": "io.hush.github",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "hush",
  "default-branch": "stable",
  "separate-locales": false,
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "hush",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
          "CARGO_HOME": "/run/build/hush/cargo-home",
          "CARGO_NET_OFFLINE": "true",
          "CARGO_BUILD_JOBS": "2",
          "CARGO_PROFILE_DEV_DEBUG": "0"
        }
      },
      "build-commands": [
        "rustc --version",
        "cargo test --frozen --all-targets",
        "cargo build --frozen --release",
        "install -Dm755 target/release/hush /app/bin/hush",
        "install -Dm644 packaging/flatpak/io.hush.github.desktop /app/share/applications/io.hush.github.desktop",
        "install -Dm644 packaging/flatpak/io.hush.github.metainfo.xml /app/share/metainfo/io.hush.github.metainfo.xml",
        "install -Dm644 assets/io.hush.github.svg /app/share/icons/hicolor/scalable/apps/io.hush.github.svg",
        "install -Dm644 LICENSE /app/share/licenses/hush/LICENSE",
        "install -Dm644 assets/fonts/OFL.txt /app/share/licenses/hush/fonts/OFL.txt",
        "install -Dm644 assets/fonts/README.md /app/share/licenses/hush/fonts/README.md"
      ],
      "sources": [{"type": "dir", "path": "source"}]
    }
  ]
}
