// Optional: in ~/.config/niri/config.kdl übernehmen.
// Absoluten Pfad anpassen. ~ und $HOME werden von niri hier nicht durch Bash expandiert.
spawn-at-startup "/home/DEIN-NAME/.local/bin/hush" "--tray"

// Optional innerhalb deines bestehenden binds-Blocks:
// Mod+G { spawn "/home/DEIN-NAME/.local/bin/hush"; }

// Hush verwendet die Wayland app_id io.hush.github.
// Optional (nicht nötig für Benachrichtigungen):
// window-rule {
//     match app-id="^io\\.hush\\.github$"
//     default-column-width { proportion 0.66; }
// }
