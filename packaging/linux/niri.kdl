// Manual alternative for sessions without an XDG autostart runner.
// Prefer Start at login in Hush settings with niri-session/systemd.
// Use only one method; remove this line before switching to Hush settings.
// Optional: add to ~/.config/niri/config.kdl.
// Adjust the absolute path. Niri does not expand ~ or $HOME through Bash here.
spawn-at-startup "/home/YOUR-USERNAME/.local/bin/hush" "--tray"

// Optional, inside your existing binds block:
// Mod+G { spawn "/home/YOUR-USERNAME/.local/bin/hush"; }

// Hush uses the Wayland app_id io.hush.github.
// Optional (not required for notifications):
// window-rule {
//     match app-id="^io\\.hush\\.github$"
//     default-column-width { proportion 0.66; }
// }
